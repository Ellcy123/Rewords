  "lines": [
    {"section": "radio_intro", "start": 0.0, "end": 5.584, "text": "喂，收到请回答"},
    {"section": "radio_intro", "start": 5.584, "end": 8.348, "text": "我没有丢下你们"},
    {"section": "radio_intro", "start": 8.348, "end": 12.458, "text": "刚刚在封三号门"},
    {"section": "radio_intro", "start": 12.458, "end": 16.161, "text": "再等我一下"},
    {"section": "verse", "start": 16.161, "end": 18.402, "text": "语音拆成一条一条"},
    {"section": "verse", "start": 18.402, "end": 20.201, "text": "每个频道都等我回报"},
    {"section": "verse", "start": 20.201, "end": 22.442, "text": "A区缺水，C区燃烧"},
    {"section": "verse", "start": 22.442, "end": 24.671, "text": "我说放心，一个都不会少"},
    {"section": "verse", "start": 24.671, "end": 26.912, "text": "发张车灯，发张路标"},
    {"section": "verse", "start": 26.912, "end": 28.247, "text": "证明我真的还在奔跑"},
    {"section": "verse", "start": 28.247, "end": 30.035, "text": "先开玩笑，再说抱歉"},
    {"section": "verse", "start": 30.035, "end": 31.382, "text": "只有抵达时间没有写"},
    {"section": "pre_chorus", "start": 31.382, "end": 33.599, "text": "四栋楼同时呼叫"},
    {"section": "pre_chorus", "start": 33.599, "end": 34.934, "text": "一辆车，一条隧道"},
    {"section": "pre_chorus", "start": 34.934, "end": 37.164, "text": "我让所有人再等五秒"},
    {"section": "pre_chorus", "start": 37.164, "end": 39.404, "text": "可尸潮已经开始倒数——"},
    {"section": "chorus", "start": 39.404, "end": 41.622, "text": "我没有把你们忙丢"},
    {"section": "chorus", "start": 41.622, "end": 43.851, "text": "Hold on，马上就走"},
    {"section": "chorus", "start": 43.851, "end": 45.639, "text": "嘴上答应每个出口"},
    {"section": "chorus", "start": 45.639, "end": 47.856, "text": "脚却停在岔路口"},
    {"section": "chorus", "start": 47.856, "end": 50.085, "text": "不是不想把你们救"},
    {"section": "chorus", "start": 50.085, "end": 51.862, "text": "是我还没学会说‘不’"},
    {"section": "chorus", "start": 51.862, "end": 53.197, "text": "当所有频道一起求救"},
    {"section": "chorus", "start": 53.197, "end": 54.555, "text": "三、二、一——"},
    {"section": "chorus", "start": 54.555, "end": 55.879, "text": "我该去哪一处？"},
    {"section": "outro", "start": 55.879, "end": 57.644, "text": "小鑫，请回答。"},
    {"section": "outro", "start": 57.644, "end": 59.408, "text": "小鑫——"},
    {"section": "outro", "start": 59.408, "end": 61.6, "text": "SOS！"},
    {"section": "outro", "start": 61.6, "end": 63.121, "text": "SFX：所有频道同时切断"}
